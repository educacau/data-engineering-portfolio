# Apache NiFi Data Lakehouse - Environment Configuration
# Copy this file to .env and update with your values

# ==============================================================================
# PostgreSQL (Iceberg Catalog)
# ==============================================================================
POSTGRES_USER=iceberg
POSTGRES_PASSWORD=CHANGE_ME_iceberg123
POSTGRES_DB=iceberg_catalog
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==============================================================================
# MinIO (S3-Compatible Storage)
# ==============================================================================
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio123
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=CHANGE_ME_minio123
AWS_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_WAREHOUSE_BUCKET=warehouse

# ==============================================================================
# Apache NiFi
# ==============================================================================
NIFI_WEB_HTTP_PORT=8443
NIFI_CLUSTER_NODE_PROTOCOL_PORT=9998
NIFI_CLUSTER_LOAD_BALANCE_PORT=6342
NIFI_JVM_HEAP_INIT=2g
NIFI_JVM_HEAP_MAX=2g
SINGLE_USER_CREDENTIALS_USERNAME=nifi
SINGLE_USER_CREDENTIALS_PASSWORD=CHANGE_ME_nifi123

# ==============================================================================
# Apache Kafka
# ==============================================================================
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,PLAINTEXT_HOST://0.0.0.0:29092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,PLAINTEXT_HOST://localhost:29092
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_DELETE_TOPIC_ENABLE=true
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_SEGMENT_BYTES=1073741824
KAFKA_NUM_PARTITIONS=3
KAFKA_DEFAULT_REPLICATION_FACTOR=1

# Schema Registry
SCHEMA_REGISTRY_HOST=schema-registry
SCHEMA_REGISTRY_PORT=8081
SCHEMA_REGISTRY_KAFKASTORE_BOOTSTRAP_SERVERS=kafka:9092

# ==============================================================================
# Apache Trino
# ==============================================================================
TRINO_ENVIRONMENT=demo
TRINO_DISCOVERY_URI=http://trino:8080
TRINO_HTTP_SERVER_PORT=8080
TRINO_COORDINATOR=true
TRINO_WORKERS=1

# ==============================================================================
# Apache Superset
# ==============================================================================
SUPERSET_SECRET_KEY=CHANGE_ME_SUPERSET_SECRET_KEY_CHANGE_ME_PLEASE
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com

# ==============================================================================
# Jupyter Lab
# ==============================================================================
JUPYTER_ENABLE_LAB=yes
JUPYTER_TOKEN=CHANGE_ME_jupyter123

# ==============================================================================
# Redis (Caching)
# ==============================================================================
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis123

# ==============================================================================
# Monitoring - Prometheus
# ==============================================================================
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d

# ==============================================================================
# Monitoring - Grafana
# ==============================================================================
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_INSTALL_PLUGINS=grafana-piechart-panel

# ==============================================================================
# Logging - Loki
# ==============================================================================
LOKI_PORT=3100

# ==============================================================================
# Spark
# ==============================================================================
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8081
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g

# ==============================================================================
# Network Configuration
# ==============================================================================
COMPOSE_PROJECT_NAME=data-lakehouse
