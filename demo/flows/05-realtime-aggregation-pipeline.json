{
  "template": {
    "@attributes": {
      "encoding-version": "1.4"
    },
    "description": "Pipeline for real-time aggregations with sliding windows for business KPIs",
    "groupId": "05-realtime-aggregation",
    "name": "Real-time Aggregation Pipeline",
    "snippet": {
      "processGroups": {
        "id": "root-pg",
        "parentGroupId": "root",
        "position": {
          "x": "0.0",
          "y": "0.0"
        },
        "comment": "Real-time aggregations with 5-minute sliding windows for business KPIs",
        "contents": {
          "processors": [
            {
              "id": "proc-consume-kafka",
              "parentGroupId": "root-pg",
              "position": {
                "x": "100.0",
                "y": "100.0"
              },
              "type": "org.apache.nifi.processors.kafka.pubsub.ConsumeKafkaRecord_2_6",
              "name": "Consume Orders Stream",
              "state": "STOPPED",
              "config": {
                "properties": {
                  "entry": [
                    {
                      "key": "bootstrap.servers",
                      "value": "kafka:9092"
                    },
                    {
                      "key": "topic",
                      "value": "orders-raw"
                    },
                    {
                      "key": "group.id",
                      "value": "nifi-realtime-aggregator"
                    },
                    {
                      "key": "Record Reader",
                      "value": "JsonTreeReader"
                    },
                    {
                      "key": "Record Writer",
                      "value": "JsonRecordSetWriter"
                    },
                    {
                      "key": "auto.offset.reset",
                      "value": "latest"
                    }
                  ]
                },
                "autoTerminatedRelationships": {
                  "element": "parse.failure"
                }
              }
            },
            {
              "id": "proc-add-window",
              "parentGroupId": "root-pg",
              "position": {
                "x": "400.0",
                "y": "100.0"
              },
              "type": "org.apache.nifi.processors.standard.UpdateRecord",
              "name": "Add Window Timestamp",
              "state": "STOPPED",
              "config": {
                "properties": {
                  "entry": [
                    {
                      "key": "Record Reader",
                      "value": "JsonTreeReader"
                    },
                    {
                      "key": "Record Writer",
                      "value": "JsonRecordSetWriter"
                    },
                    {
                      "key": "/window_start",
                      "value": "${now():toNumber():divide(300000):floor():multiply(300000):format('yyyy-MM-dd HH:mm:ss')}"
                    },
                    {
                      "key": "/window_end",
                      "value": "${now():toNumber():divide(300000):floor():plus(1):multiply(300000):format('yyyy-MM-dd HH:mm:ss')}"
                    }
                  ]
                },
                "autoTerminatedRelationships": {
                  "element": "failure"
                }
              }
            },
            {
              "id": "proc-aggregate",
              "parentGroupId": "root-pg",
              "position": {
                "x": "700.0",
                "y": "100.0"
              },
              "type": "org.apache.nifi.processors.standard.PartitionRecord",
              "name": "Partition by Window-Region",
              "state": "STOPPED",
              "config": {
                "properties": {
                  "entry": [
                    {
                      "key": "Record Reader",
                      "value": "JsonTreeReader"
                    },
                    {
                      "key": "Record Writer",
                      "value": "JsonRecordSetWriter"
                    },
                    {
                      "key": "Partition Record Path",
                      "value": "/window_start,/region"
                    }
                  ]
                },
                "autoTerminatedRelationships": {
                  "element": "failure"
                }
              }
            },
            {
              "id": "proc-calculate-metrics",
              "parentGroupId": "root-pg",
              "position": {
                "x": "1000.0",
                "y": "100.0"
              },
              "type": "org.apache.nifi.processors.standard.QueryRecord",
              "name": "Calculate KPIs",
              "state": "STOPPED",
              "config": {
                "properties": {
                  "entry": [
                    {
                      "key": "Record Reader",
                      "value": "JsonTreeReader"
                    },
                    {
                      "key": "Record Writer",
                      "value": "JsonRecordSetWriter"
                    },
                    {
                      "key": "aggregated",
                      "value": "SELECT\n    window_start,\n    window_end,\n    region,\n    COUNT(*) as order_count,\n    SUM(total_amount) as total_revenue,\n    AVG(total_amount) as avg_order_value,\n    MIN(total_amount) as min_order_value,\n    MAX(total_amount) as max_order_value,\n    COUNT(DISTINCT customer_id) as unique_customers\nFROM FLOWFILE\nGROUP BY window_start, window_end, region"
                    }
                  ]
                },
                "autoTerminatedRelationships": {
                  "element": "failure"
                }
              }
            },
            {
              "id": "proc-add-metadata",
              "parentGroupId": "root-pg",
              "position": {
                "x": "1300.0",
                "y": "100.0"
              },
              "type": "org.apache.nifi.processors.standard.UpdateRecord",
              "name": "Add Aggregation Metadata",
              "state": "STOPPED",
              "config": {
                "properties": {
                  "entry": [
                    {
                      "key": "Record Reader",
                      "value": "JsonTreeReader"
                    },
                    {
                      "key": "Record Writer",
                      "value": "JsonRecordSetWriter"
                    },
                    {
                      "key": "/computed_at",
                      "value": "${now():format('yyyy-MM-dd HH:mm:ss')}"
                    },
                    {
                      "key": "/aggregation_type",
                      "value": "5min_sliding_window"
                    },
                    {
                      "key": "/pipeline_version",
                      "value": "v1.0"
                    }
                  ]
                },
                "autoTerminatedRelationships": {
                  "element": "failure"
                }
              }
            },
            {
              "id": "proc-publish-kafka",
              "parentGroupId": "root-pg",
              "position": {
                "x": "1600.0",
                "y": "100.0"
              },
              "type": "org.apache.nifi.processors.kafka.pubsub.PublishKafkaRecord_2_6",
              "name": "Publish to Aggregated Topic",
              "state": "STOPPED",
              "config": {
                "properties": {
                  "entry": [
                    {
                      "key": "bootstrap.servers",
                      "value": "kafka:9092"
                    },
                    {
                      "key": "topic",
                      "value": "orders-aggregated-5min"
                    },
                    {
                      "key": "Record Reader",
                      "value": "JsonTreeReader"
                    },
                    {
                      "key": "Record Writer",
                      "value": "JsonRecordSetWriter"
                    },
                    {
                      "key": "message-key-field",
                      "value": "region"
                    }
                  ]
                },
                "autoTerminatedRelationships": {
                  "element": "success"
                }
              }
            },
            {
              "id": "proc-write-trino",
              "parentGroupId": "root-pg",
              "position": {
                "x": "1600.0",
                "y": "300.0"
              },
              "type": "org.apache.nifi.processors.standard.PutDatabaseRecord",
              "name": "Write to Trino Aggregation Table",
              "state": "STOPPED",
              "config": {
                "properties": {
                  "entry": [
                    {
                      "key": "Database Connection Pooling Service",
                      "value": "TrinoConnectionPool"
                    },
                    {
                      "key": "Record Reader",
                      "value": "JsonTreeReader"
                    },
                    {
                      "key": "Statement Type",
                      "value": "INSERT"
                    },
                    {
                      "key": "Table Name",
                      "value": "lakehouse.realtime_kpis"
                    },
                    {
                      "key": "Translate Field Names",
                      "value": "true"
                    }
                  ]
                },
                "autoTerminatedRelationships": {
                  "element": [
                    "success",
                    "failure"
                  ]
                }
              }
            },
            {
              "id": "proc-detect-anomalies",
              "parentGroupId": "root-pg",
              "position": {
                "x": "1900.0",
                "y": "100.0"
              },
              "type": "org.apache.nifi.processors.standard.RouteOnAttribute",
              "name": "Detect Revenue Anomalies",
              "state": "STOPPED",
              "config": {
                "properties": {
                  "entry": [
                    {
                      "key": "Routing Strategy",
                      "value": "Route to Property name"
                    },
                    {
                      "key": "high_revenue",
                      "value": "${total_revenue:gt(50000)}"
                    },
                    {
                      "key": "low_revenue",
                      "value": "${total_revenue:lt(1000)}"
                    },
                    {
                      "key": "normal",
                      "value": "${total_revenue:ge(1000):and(${total_revenue:le(50000)})}"
                    }
                  ]
                },
                "autoTerminatedRelationships": {
                  "element": "unmatched"
                }
              }
            },
            {
              "id": "proc-alert-high",
              "parentGroupId": "root-pg",
              "position": {
                "x": "2200.0",
                "y": "50.0"
              },
              "type": "org.apache.nifi.processors.standard.LogAttribute",
              "name": "Alert: High Revenue Window",
              "state": "STOPPED",
              "config": {
                "properties": {
                  "entry": [
                    {
                      "key": "Log Level",
                      "value": "warn"
                    },
                    {
                      "key": "Log Payload",
                      "value": "true"
                    },
                    {
                      "key": "Log prefix",
                      "value": "HIGH_REVENUE_ALERT:"
                    }
                  ]
                },
                "autoTerminatedRelationships": {
                  "element": "success"
                }
              }
            },
            {
              "id": "proc-alert-low",
              "parentGroupId": "root-pg",
              "position": {
                "x": "2200.0",
                "y": "150.0"
              },
              "type": "org.apache.nifi.processors.standard.LogAttribute",
              "name": "Alert: Low Revenue Window",
              "state": "STOPPED",
              "config": {
                "properties": {
                  "entry": [
                    {
                      "key": "Log Level",
                      "value": "warn"
                    },
                    {
                      "key": "Log Payload",
                      "value": "true"
                    },
                    {
                      "key": "Log prefix",
                      "value": "LOW_REVENUE_ALERT:"
                    }
                  ]
                },
                "autoTerminatedRelationships": {
                  "element": "success"
                }
              }
            }
          ],
          "connections": [
            {
              "id": "conn-1",
              "source": {
                "id": "proc-consume-kafka",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "destination": {
                "id": "proc-add-window",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "selectedRelationships": {
                "element": "success"
              }
            },
            {
              "id": "conn-2",
              "source": {
                "id": "proc-add-window",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "destination": {
                "id": "proc-aggregate",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "selectedRelationships": {
                "element": "success"
              }
            },
            {
              "id": "conn-3",
              "source": {
                "id": "proc-aggregate",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "destination": {
                "id": "proc-calculate-metrics",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "selectedRelationships": {
                "element": "success"
              }
            },
            {
              "id": "conn-4",
              "source": {
                "id": "proc-calculate-metrics",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "destination": {
                "id": "proc-add-metadata",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "selectedRelationships": {
                "element": "aggregated"
              }
            },
            {
              "id": "conn-5",
              "source": {
                "id": "proc-add-metadata",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "destination": {
                "id": "proc-publish-kafka",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "selectedRelationships": {
                "element": "success"
              }
            },
            {
              "id": "conn-6",
              "source": {
                "id": "proc-add-metadata",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "destination": {
                "id": "proc-write-trino",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "selectedRelationships": {
                "element": "success"
              }
            },
            {
              "id": "conn-7",
              "source": {
                "id": "proc-publish-kafka",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "destination": {
                "id": "proc-detect-anomalies",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "selectedRelationships": {
                "element": "success"
              }
            },
            {
              "id": "conn-8",
              "source": {
                "id": "proc-detect-anomalies",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "destination": {
                "id": "proc-alert-high",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "selectedRelationships": {
                "element": "high_revenue"
              }
            },
            {
              "id": "conn-9",
              "source": {
                "id": "proc-detect-anomalies",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "destination": {
                "id": "proc-alert-low",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "selectedRelationships": {
                "element": "low_revenue"
              }
            },
            {
              "id": "conn-10",
              "source": {
                "id": "proc-detect-anomalies",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "destination": {
                "id": "proc-detect-anomalies",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "selectedRelationships": {
                "element": "normal"
              },
              "backPressureObjectThreshold": "10000",
              "backPressureDataSizeThreshold": "1 GB"
            }
          ]
        },
        "name": "Real-time Aggregation Pipeline"
      }
    },
    "timestamp": "2026-02-05T12:00:00Z"
  },
  "_metadata": {
    "source": "05-realtime-aggregation-pipeline.xml",
    "format": "nifi-registry-json",
    "version": "1.0"
  }
}