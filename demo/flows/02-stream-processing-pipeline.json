{
  "template": {
    "@attributes": {
      "encoding-version": "1.4"
    },
    "description": "Pipeline for consuming Kafka events, enriching with customer data, and writing to Iceberg",
    "groupId": "02-stream-processing",
    "name": "Stream Processing Pipeline",
    "snippet": {
      "processGroups": {
        "id": "root-pg",
        "parentGroupId": "root",
        "position": {
          "x": "0.0",
          "y": "0.0"
        },
        "comment": "Consumes orders from Kafka, enriches with customer data, and persists to Iceberg lakehouse",
        "contents": {
          "processors": [
            {
              "id": "proc-consume-kafka",
              "parentGroupId": "root-pg",
              "position": {
                "x": "100.0",
                "y": "100.0"
              },
              "type": "org.apache.nifi.processors.kafka.pubsub.ConsumeKafkaRecord_2_6",
              "name": "Consume Orders from Kafka",
              "state": "STOPPED",
              "config": {
                "properties": {
                  "entry": [
                    {
                      "key": "bootstrap.servers",
                      "value": "kafka:9092"
                    },
                    {
                      "key": "topic",
                      "value": "orders-raw"
                    },
                    {
                      "key": "topic_type",
                      "value": "names"
                    },
                    {
                      "key": "group.id",
                      "value": "nifi-stream-processor"
                    },
                    {
                      "key": "Record Reader",
                      "value": "JsonTreeReader"
                    },
                    {
                      "key": "Record Writer",
                      "value": "JsonRecordSetWriter"
                    },
                    {
                      "key": "auto.offset.reset",
                      "value": "earliest"
                    },
                    {
                      "key": "max.poll.records",
                      "value": "500"
                    },
                    {
                      "key": "Communications Timeout",
                      "value": "60 sec"
                    }
                  ]
                },
                "autoTerminatedRelationships": {
                  "element": "parse.failure"
                }
              }
            },
            {
              "id": "proc-enrich-customer",
              "parentGroupId": "root-pg",
              "position": {
                "x": "400.0",
                "y": "100.0"
              },
              "type": "org.apache.nifi.processors.standard.LookupRecord",
              "name": "Enrich Customer Data",
              "state": "STOPPED",
              "config": {
                "properties": {
                  "entry": [
                    {
                      "key": "Record Reader",
                      "value": "JsonTreeReader"
                    },
                    {
                      "key": "Record Writer",
                      "value": "JsonRecordSetWriter"
                    },
                    {
                      "key": "Lookup Service",
                      "value": "CustomerLookupService"
                    },
                    {
                      "key": "Result RecordPath",
                      "value": "/customer"
                    },
                    {
                      "key": "Routing Strategy",
                      "value": "Route to 'success'"
                    }
                  ]
                },
                "autoTerminatedRelationships": {
                  "element": "failure"
                }
              }
            },
            {
              "id": "proc-add-metadata",
              "parentGroupId": "root-pg",
              "position": {
                "x": "700.0",
                "y": "100.0"
              },
              "type": "org.apache.nifi.processors.standard.UpdateRecord",
              "name": "Add Processing Metadata",
              "state": "STOPPED",
              "config": {
                "properties": {
                  "entry": [
                    {
                      "key": "Record Reader",
                      "value": "JsonTreeReader"
                    },
                    {
                      "key": "Record Writer",
                      "value": "JsonRecordSetWriter"
                    },
                    {
                      "key": "/processing_timestamp",
                      "value": "${now():format('yyyy-MM-dd HH:mm:ss')}"
                    },
                    {
                      "key": "/pipeline_version",
                      "value": "v1.0"
                    },
                    {
                      "key": "/processed_by",
                      "value": "nifi-stream-processor"
                    }
                  ]
                },
                "autoTerminatedRelationships": {
                  "element": "failure"
                }
              }
            },
            {
              "id": "proc-calculate-fields",
              "parentGroupId": "root-pg",
              "position": {
                "x": "1000.0",
                "y": "100.0"
              },
              "type": "org.apache.nifi.processors.standard.UpdateRecord",
              "name": "Calculate Derived Fields",
              "state": "STOPPED",
              "config": {
                "properties": {
                  "entry": [
                    {
                      "key": "Record Reader",
                      "value": "JsonTreeReader"
                    },
                    {
                      "key": "Record Writer",
                      "value": "JsonRecordSetWriter"
                    },
                    {
                      "key": "/order_date_year",
                      "value": "${field.value:toDate('yyyy-MM-dd'):format('yyyy')}"
                    },
                    {
                      "key": "/order_date_month",
                      "value": "${field.value:toDate('yyyy-MM-dd'):format('MM')}"
                    },
                    {
                      "key": "/is_high_value",
                      "value": "${field.value:gt(1000)}"
                    }
                  ]
                },
                "autoTerminatedRelationships": {
                  "element": "failure"
                }
              }
            },
            {
              "id": "proc-to-parquet",
              "parentGroupId": "root-pg",
              "position": {
                "x": "1300.0",
                "y": "100.0"
              },
              "type": "org.apache.nifi.processors.standard.ConvertRecord",
              "name": "Convert to Parquet",
              "state": "STOPPED",
              "config": {
                "properties": {
                  "entry": [
                    {
                      "key": "Record Reader",
                      "value": "JsonTreeReader"
                    },
                    {
                      "key": "Record Writer",
                      "value": "ParquetRecordSetWriter"
                    }
                  ]
                },
                "autoTerminatedRelationships": {
                  "element": "failure"
                }
              }
            },
            {
              "id": "proc-write-iceberg",
              "parentGroupId": "root-pg",
              "position": {
                "x": "1600.0",
                "y": "100.0"
              },
              "type": "org.apache.nifi.processors.iceberg.PutIceberg",
              "name": "Write to Iceberg",
              "state": "STOPPED",
              "config": {
                "properties": {
                  "entry": [
                    {
                      "key": "Catalog Service",
                      "value": "IcebergCatalogService"
                    },
                    {
                      "key": "Catalog Namespace",
                      "value": "lakehouse"
                    },
                    {
                      "key": "Table Name",
                      "value": "orders_enriched"
                    },
                    {
                      "key": "Record Reader",
                      "value": "ParquetReader"
                    },
                    {
                      "key": "Write Mode",
                      "value": "APPEND"
                    },
                    {
                      "key": "File Format",
                      "value": "PARQUET"
                    }
                  ]
                },
                "autoTerminatedRelationships": {
                  "element": "success"
                }
              }
            },
            {
              "id": "proc-log-errors",
              "parentGroupId": "root-pg",
              "position": {
                "x": "1300.0",
                "y": "400.0"
              },
              "type": "org.apache.nifi.processors.standard.LogAttribute",
              "name": "Log Processing Errors",
              "state": "STOPPED",
              "config": {
                "properties": {
                  "entry": [
                    {
                      "key": "Log Level",
                      "value": "error"
                    },
                    {
                      "key": "Log Payload",
                      "value": "true"
                    },
                    {
                      "key": "Attributes to Log",
                      "value": "kafka.topic,kafka.partition,kafka.offset"
                    }
                  ]
                },
                "autoTerminatedRelationships": {
                  "element": "success"
                }
              }
            }
          ],
          "connections": [
            {
              "id": "conn-1",
              "name": "kafka to enrich",
              "source": {
                "id": "proc-consume-kafka",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "destination": {
                "id": "proc-enrich-customer",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "selectedRelationships": {
                "element": "success"
              }
            },
            {
              "id": "conn-2",
              "name": "enrich to metadata",
              "source": {
                "id": "proc-enrich-customer",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "destination": {
                "id": "proc-add-metadata",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "selectedRelationships": {
                "element": "success"
              }
            },
            {
              "id": "conn-3",
              "name": "metadata to calculate",
              "source": {
                "id": "proc-add-metadata",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "destination": {
                "id": "proc-calculate-fields",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "selectedRelationships": {
                "element": "success"
              }
            },
            {
              "id": "conn-4",
              "name": "calculate to parquet",
              "source": {
                "id": "proc-calculate-fields",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "destination": {
                "id": "proc-to-parquet",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "selectedRelationships": {
                "element": "success"
              }
            },
            {
              "id": "conn-5",
              "name": "parquet to iceberg",
              "source": {
                "id": "proc-to-parquet",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "destination": {
                "id": "proc-write-iceberg",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "selectedRelationships": {
                "element": "success"
              }
            },
            {
              "id": "conn-6",
              "name": "errors to log",
              "source": {
                "id": "proc-write-iceberg",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "destination": {
                "id": "proc-log-errors",
                "groupId": "root-pg",
                "type": "PROCESSOR"
              },
              "selectedRelationships": {
                "element": "failure"
              }
            }
          ]
        },
        "name": "Stream Processing Pipeline"
      }
    },
    "timestamp": "2026-02-05T10:30:00Z"
  },
  "_metadata": {
    "source": "02-stream-processing-pipeline.xml",
    "format": "nifi-registry-json",
    "version": "1.0"
  }
}