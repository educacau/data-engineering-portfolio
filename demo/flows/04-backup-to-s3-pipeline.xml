<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Flow: Backup to S3 Pipeline
  Description: Daily backup of Iceberg tables to MinIO S3-compatible storage
  Author: Data Engineering Portfolio
  Version: 1.0
-->
<template encoding-version="1.4">
    <description>Pipeline for daily backup of data lakehouse tables to S3 storage</description>
    <groupId>04-backup-to-s3</groupId>
    <name>Backup to S3 Pipeline</name>
    <snippet>
        <processGroups>
            <id>root-pg</id>
            <parentGroupId>root</parentGroupId>
            <position>
                <x>0.0</x>
                <y>0.0</y>
            </position>
            <comment>Daily backup of Iceberg tables to MinIO S3 with retention policy</comment>
            <contents>
                <!-- Processor 1: Schedule Backup Trigger -->
                <processors>
                    <id>proc-trigger</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>100.0</x>
                        <y>100.0</y>
                    </position>
                    <type>org.apache.nifi.processors.standard.GenerateFlowFile</type>
                    <name>Daily Backup Trigger</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>File Size</key>
                                <value>0B</value>
                            </entry>
                            <entry>
                                <key>Batch Size</key>
                                <value>1</value>
                            </entry>
                            <entry>
                                <key>Unique FlowFiles</key>
                                <value>true</value>
                            </entry>
                            <entry>
                                <key>Data Format</key>
                                <value>Text</value>
                            </entry>
                        </properties>
                        <schedulingPeriod>0 2 * * *</schedulingPeriod>
                        <schedulingStrategy>CRON_DRIVEN</schedulingStrategy>
                    </config>
                </processors>

                <!-- Processor 2: Add Backup Metadata -->
                <processors>
                    <id>proc-add-metadata</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>400.0</x>
                        <y>100.0</y>
                    </position>
                    <type>org.apache.nifi.processors.attributes.UpdateAttribute</type>
                    <name>Add Backup Metadata</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>backup.timestamp</key>
                                <value>${now():format('yyyy-MM-dd_HHmmss')}</value>
                            </entry>
                            <entry>
                                <key>backup.date</key>
                                <value>${now():format('yyyy-MM-dd')}</value>
                            </entry>
                            <entry>
                                <key>backup.type</key>
                                <value>daily</value>
                            </entry>
                            <entry>
                                <key>s3.bucket</key>
                                <value>lakehouse-backups</value>
                            </entry>
                            <entry>
                                <key>s3.prefix</key>
                                <value>backups/${backup.date}/</value>
                            </entry>
                        </properties>
                    </config>
                </processors>

                <!-- Processor 3: Query Orders Table -->
                <processors>
                    <id>proc-query-orders</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>700.0</x>
                        <y>100.0</y>
                    </position>
                    <type>org.apache.nifi.processors.standard.ExecuteSQLRecord</type>
                    <name>Export Orders Table</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>Database Connection Pooling Service</key>
                                <value>TrinoConnectionPool</value>
                            </entry>
                            <entry>
                                <key>SQL select query</key>
                                <value>SELECT * FROM lakehouse.orders_enriched</value>
                            </entry>
                            <entry>
                                <key>Record Writer</key>
                                <value>ParquetRecordSetWriter</value>
                            </entry>
                            <entry>
                                <key>Normalize Table/Column Names</key>
                                <value>true</value>
                            </entry>
                        </properties>
                        <autoTerminatedRelationships>
                            <element>failure</element>
                        </autoTerminatedRelationships>
                    </config>
                </processors>

                <!-- Processor 4: Compress Backup File -->
                <processors>
                    <id>proc-compress</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>1000.0</x>
                        <y>100.0</y>
                    </position>
                    <type>org.apache.nifi.processors.standard.CompressContent</type>
                    <name>Compress with Gzip</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>Mode</key>
                                <value>compress</value>
                            </entry>
                            <entry>
                                <key>Compression Format</key>
                                <value>gzip</value>
                            </entry>
                            <entry>
                                <key>Compression Level</key>
                                <value>9</value>
                            </entry>
                        </properties>
                        <autoTerminatedRelationships>
                            <element>failure</element>
                        </autoTerminatedRelationships>
                    </config>
                </processors>

                <!-- Processor 5: Update S3 Filename -->
                <processors>
                    <id>proc-update-filename</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>1300.0</x>
                        <y>100.0</y>
                    </position>
                    <type>org.apache.nifi.processors.attributes.UpdateAttribute</type>
                    <name>Set S3 Object Key</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>filename</key>
                                <value>orders_enriched_${backup.timestamp}.parquet.gz</value>
                            </entry>
                            <entry>
                                <key>s3.object.key</key>
                                <value>${s3.prefix}${filename}</value>
                            </entry>
                        </properties>
                    </config>
                </processors>

                <!-- Processor 6: Upload to S3 -->
                <processors>
                    <id>proc-put-s3</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>1600.0</x>
                        <y>100.0</y>
                    </position>
                    <type>org.apache.nifi.processors.aws.s3.PutS3Object</type>
                    <name>Upload to MinIO S3</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>Bucket</key>
                                <value>${s3.bucket}</value>
                            </entry>
                            <entry>
                                <key>Object Key</key>
                                <value>${s3.object.key}</value>
                            </entry>
                            <entry>
                                <key>Endpoint Override URL</key>
                                <value>http://minio:9000</value>
                            </entry>
                            <entry>
                                <key>AWS Credentials Provider service</key>
                                <value>AWSCredentialsProviderControllerService</value>
                            </entry>
                            <entry>
                                <key>Storage Class</key>
                                <value>STANDARD</value>
                            </entry>
                            <entry>
                                <key>Server Side Encryption</key>
                                <value>None</value>
                            </entry>
                        </properties>
                        <autoTerminatedRelationships>
                            <element>failure</element>
                        </autoTerminatedRelationships>
                    </config>
                </processors>

                <!-- Processor 7: Log Backup Success -->
                <processors>
                    <id>proc-log-success</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>1900.0</x>
                        <y>100.0</y>
                    </position>
                    <type>org.apache.nifi.processors.standard.LogAttribute</type>
                    <name>Log Backup Success</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>Log Level</key>
                                <value>info</value>
                            </entry>
                            <entry>
                                <key>Log Payload</key>
                                <value>false</value>
                            </entry>
                            <entry>
                                <key>Attributes to Log</key>
                                <value>backup.timestamp,s3.bucket,s3.object.key,file.size</value>
                            </entry>
                            <entry>
                                <key>Log prefix</key>
                                <value>BACKUP_SUCCESS:</value>
                            </entry>
                        </properties>
                        <autoTerminatedRelationships>
                            <element>success</element>
                        </autoTerminatedRelationships>
                    </config>
                </processors>

                <!-- Processor 8: Cleanup Old Backups Trigger -->
                <processors>
                    <id>proc-cleanup-trigger</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>100.0</x>
                        <y>400.0</y>
                    </position>
                    <type>org.apache.nifi.processors.standard.GenerateFlowFile</type>
                    <name>Weekly Cleanup Trigger</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>File Size</key>
                                <value>0B</value>
                            </entry>
                            <entry>
                                <key>Batch Size</key>
                                <value>1</value>
                            </entry>
                        </properties>
                        <schedulingPeriod>0 3 * * 0</schedulingPeriod>
                        <schedulingStrategy>CRON_DRIVEN</schedulingStrategy>
                    </config>
                </processors>

                <!-- Processor 9: List Old Backups -->
                <processors>
                    <id>proc-list-old-backups</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>400.0</x>
                        <y>400.0</y>
                    </position>
                    <type>org.apache.nifi.processors.aws.s3.ListS3</type>
                    <name>List Backups Older Than 30 Days</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>Bucket</key>
                                <value>lakehouse-backups</value>
                            </entry>
                            <entry>
                                <key>Prefix</key>
                                <value>backups/</value>
                            </entry>
                            <entry>
                                <key>Endpoint Override URL</key>
                                <value>http://minio:9000</value>
                            </entry>
                            <entry>
                                <key>AWS Credentials Provider service</key>
                                <value>AWSCredentialsProviderControllerService</value>
                            </entry>
                            <entry>
                                <key>min-age</key>
                                <value>30 days</value>
                            </entry>
                        </properties>
                        <autoTerminatedRelationships>
                            <element>success</element>
                        </autoTerminatedRelationships>
                    </config>
                </processors>

                <!-- Processor 10: Delete Old Backups -->
                <processors>
                    <id>proc-delete-old-backups</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>700.0</x>
                        <y>400.0</y>
                    </position>
                    <type>org.apache.nifi.processors.aws.s3.DeleteS3Object</type>
                    <name>Delete Old Backups</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>Bucket</key>
                                <value>${s3.bucket}</value>
                            </entry>
                            <entry>
                                <key>Object Key</key>
                                <value>${filename}</value>
                            </entry>
                            <entry>
                                <key>Endpoint Override URL</key>
                                <value>http://minio:9000</value>
                            </entry>
                            <entry>
                                <key>AWS Credentials Provider service</key>
                                <value>AWSCredentialsProviderControllerService</value>
                            </entry>
                        </properties>
                        <autoTerminatedRelationships>
                            <element>success</element>
                            <element>failure</element>
                        </autoTerminatedRelationships>
                    </config>
                </processors>

                <!-- Connections -->
                <connections>
                    <id>conn-1</id>
                    <source>
                        <id>proc-trigger</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </source>
                    <destination>
                        <id>proc-add-metadata</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </destination>
                    <selectedRelationships>
                        <element>success</element>
                    </selectedRelationships>
                </connections>

                <connections>
                    <id>conn-2</id>
                    <source>
                        <id>proc-add-metadata</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </source>
                    <destination>
                        <id>proc-query-orders</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </destination>
                    <selectedRelationships>
                        <element>success</element>
                    </selectedRelationships>
                </connections>

                <connections>
                    <id>conn-3</id>
                    <source>
                        <id>proc-query-orders</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </source>
                    <destination>
                        <id>proc-compress</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </destination>
                    <selectedRelationships>
                        <element>success</element>
                    </selectedRelationships>
                </connections>

                <connections>
                    <id>conn-4</id>
                    <source>
                        <id>proc-compress</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </source>
                    <destination>
                        <id>proc-update-filename</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </destination>
                    <selectedRelationships>
                        <element>success</element>
                    </selectedRelationships>
                </connections>

                <connections>
                    <id>conn-5</id>
                    <source>
                        <id>proc-update-filename</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </source>
                    <destination>
                        <id>proc-put-s3</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </destination>
                    <selectedRelationships>
                        <element>success</element>
                    </selectedRelationships>
                </connections>

                <connections>
                    <id>conn-6</id>
                    <source>
                        <id>proc-put-s3</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </source>
                    <destination>
                        <id>proc-log-success</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </destination>
                    <selectedRelationships>
                        <element>success</element>
                    </selectedRelationships>
                </connections>

                <connections>
                    <id>conn-7</id>
                    <source>
                        <id>proc-cleanup-trigger</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </source>
                    <destination>
                        <id>proc-list-old-backups</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </destination>
                    <selectedRelationships>
                        <element>success</element>
                    </selectedRelationships>
                </connections>

                <connections>
                    <id>conn-8</id>
                    <source>
                        <id>proc-list-old-backups</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </source>
                    <destination>
                        <id>proc-delete-old-backups</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </destination>
                    <selectedRelationships>
                        <element>success</element>
                    </selectedRelationships>
                </connections>
            </contents>
            <name>Backup to S3 Pipeline</name>
        </processGroups>
    </snippet>
    <timestamp>2026-02-05T11:30:00Z</timestamp>
</template>
