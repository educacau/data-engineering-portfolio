<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Flow: Data Quality Pipeline
  Description: Validates data quality rules and generates quality reports
  Author: Data Engineering Portfolio
  Version: 1.0
-->
<template encoding-version="1.4">
    <description>Pipeline for data quality validation with Great Expectations integration</description>
    <groupId>03-data-quality</groupId>
    <name>Data Quality Pipeline</name>
    <snippet>
        <processGroups>
            <id>root-pg</id>
            <parentGroupId>root</parentGroupId>
            <position>
                <x>0.0</x>
                <y>0.0</y>
            </position>
            <comment>Validates data quality rules, detects anomalies, and generates quality reports</comment>
            <contents>
                <!-- Processor 1: Query Iceberg Table -->
                <processors>
                    <id>proc-query-iceberg</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>100.0</x>
                        <y>100.0</y>
                    </position>
                    <type>org.apache.nifi.processors.standard.ExecuteSQLRecord</type>
                    <name>Query Recent Orders</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>Database Connection Pooling Service</key>
                                <value>TrinoConnectionPool</value>
                            </entry>
                            <entry>
                                <key>SQL select query</key>
                                <value>SELECT * FROM lakehouse.orders_enriched WHERE processing_timestamp >= current_timestamp - interval '1' hour</value>
                            </entry>
                            <entry>
                                <key>Record Writer</key>
                                <value>JsonRecordSetWriter</value>
                            </entry>
                        </properties>
                        <schedulingPeriod>5 min</schedulingPeriod>
                        <schedulingStrategy>TIMER_DRIVEN</schedulingStrategy>
                        <autoTerminatedRelationships>
                            <element>failure</element>
                        </autoTerminatedRelationships>
                    </config>
                </processors>

                <!-- Processor 2: Check Null Values -->
                <processors>
                    <id>proc-check-nulls</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>400.0</x>
                        <y>100.0</y>
                    </position>
                    <type>org.apache.nifi.processors.standard.QueryRecord</type>
                    <name>Check Null Values</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>Record Reader</key>
                                <value>JsonTreeReader</value>
                            </entry>
                            <entry>
                                <key>Record Writer</key>
                                <value>JsonRecordSetWriter</value>
                            </entry>
                            <entry>
                                <key>valid</key>
                                <value>SELECT * FROM FLOWFILE WHERE order_id IS NOT NULL AND customer_id IS NOT NULL AND total_amount IS NOT NULL</value>
                            </entry>
                            <entry>
                                <key>null_violations</key>
                                <value>SELECT * FROM FLOWFILE WHERE order_id IS NULL OR customer_id IS NULL OR total_amount IS NULL</value>
                            </entry>
                        </properties>
                        <autoTerminatedRelationships>
                            <element>failure</element>
                        </autoTerminatedRelationships>
                    </config>
                </processors>

                <!-- Processor 3: Check Value Ranges -->
                <processors>
                    <id>proc-check-ranges</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>700.0</x>
                        <y>100.0</y>
                    </position>
                    <type>org.apache.nifi.processors.standard.QueryRecord</type>
                    <name>Check Value Ranges</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>Record Reader</key>
                                <value>JsonTreeReader</value>
                            </entry>
                            <entry>
                                <key>Record Writer</key>
                                <value>JsonRecordSetWriter</value>
                            </entry>
                            <entry>
                                <key>valid</key>
                                <value>SELECT * FROM FLOWFILE WHERE total_amount &gt; 0 AND total_amount &lt; 100000</value>
                            </entry>
                            <entry>
                                <key>range_violations</key>
                                <value>SELECT * FROM FLOWFILE WHERE total_amount &lt;= 0 OR total_amount &gt;= 100000</value>
                            </entry>
                        </properties>
                        <autoTerminatedRelationships>
                            <element>failure</element>
                        </autoTerminatedRelationships>
                    </config>
                </processors>

                <!-- Processor 4: Check Referential Integrity -->
                <processors>
                    <id>proc-check-integrity</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>1000.0</x>
                        <y>100.0</y>
                    </position>
                    <type>org.apache.nifi.processors.standard.LookupRecord</type>
                    <name>Check Customer Exists</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>Record Reader</key>
                                <value>JsonTreeReader</value>
                            </entry>
                            <entry>
                                <key>Record Writer</key>
                                <value>JsonRecordSetWriter</value>
                            </entry>
                            <entry>
                                <key>Lookup Service</key>
                                <value>CustomerLookupService</value>
                            </entry>
                            <entry>
                                <key>Result RecordPath</key>
                                <value>/customer_exists</value>
                            </entry>
                            <entry>
                                <key>Routing Strategy</key>
                                <value>Route to 'success'</value>
                            </entry>
                        </properties>
                    </config>
                </processors>

                <!-- Processor 5: Detect Anomalies -->
                <processors>
                    <id>proc-detect-anomalies</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>1300.0</x>
                        <y>100.0</y>
                    </position>
                    <type>org.apache.nifi.processors.standard.QueryRecord</type>
                    <name>Detect Anomalies</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>Record Reader</key>
                                <value>JsonTreeReader</value>
                            </entry>
                            <entry>
                                <key>Record Writer</key>
                                <value>JsonRecordSetWriter</value>
                            </entry>
                            <entry>
                                <key>normal</key>
                                <value>SELECT * FROM FLOWFILE WHERE customer_exists IS NOT NULL</value>
                            </entry>
                            <entry>
                                <key>anomalies</key>
                                <value>SELECT * FROM FLOWFILE WHERE customer_exists IS NULL</value>
                            </entry>
                        </properties>
                        <autoTerminatedRelationships>
                            <element>failure</element>
                        </autoTerminatedRelationships>
                    </config>
                </processors>

                <!-- Processor 6: Generate Quality Report -->
                <processors>
                    <id>proc-generate-report</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>1600.0</x>
                        <y>100.0</y>
                    </position>
                    <type>org.apache.nifi.processors.standard.JoltTransformRecord</type>
                    <name>Generate Quality Report</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>Record Reader</key>
                                <value>JsonTreeReader</value>
                            </entry>
                            <entry>
                                <key>Record Writer</key>
                                <value>JsonRecordSetWriter</value>
                            </entry>
                            <entry>
                                <key>Jolt Specification</key>
                                <value>{
  "operation": "shift",
  "spec": {
    "*": {
      "order_id": "quality_checks[&amp;1].order_id",
      "total_amount": "quality_checks[&amp;1].total_amount",
      "customer_exists": "quality_checks[&amp;1].referential_integrity_passed"
    }
  }
}</value>
                            </entry>
                        </properties>
                        <autoTerminatedRelationships>
                            <element>failure</element>
                        </autoTerminatedRelationships>
                    </config>
                </processors>

                <!-- Processor 7: Publish Quality Metrics -->
                <processors>
                    <id>proc-publish-metrics</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>1900.0</x>
                        <y>100.0</y>
                    </position>
                    <type>org.apache.nifi.processors.kafka.pubsub.PublishKafkaRecord_2_6</type>
                    <name>Publish to Quality Metrics Topic</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>bootstrap.servers</key>
                                <value>kafka:9092</value>
                            </entry>
                            <entry>
                                <key>topic</key>
                                <value>data-quality-metrics</value>
                            </entry>
                            <entry>
                                <key>Record Reader</key>
                                <value>JsonTreeReader</value>
                            </entry>
                            <entry>
                                <key>Record Writer</key>
                                <value>JsonRecordSetWriter</value>
                            </entry>
                        </properties>
                        <autoTerminatedRelationships>
                            <element>success</element>
                        </autoTerminatedRelationships>
                    </config>
                </processors>

                <!-- Processor 8: Handle Violations (Null) -->
                <processors>
                    <id>proc-handle-null-violations</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>400.0</x>
                        <y>400.0</y>
                    </position>
                    <type>org.apache.nifi.processors.standard.PutFile</type>
                    <name>Save Null Violations</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>Directory</key>
                                <value>/data/quality-violations/null-checks</value>
                            </entry>
                            <entry>
                                <key>Conflict Resolution Strategy</key>
                                <value>replace</value>
                            </entry>
                        </properties>
                        <autoTerminatedRelationships>
                            <element>success</element>
                            <element>failure</element>
                        </autoTerminatedRelationships>
                    </config>
                </processors>

                <!-- Processor 9: Handle Violations (Range) -->
                <processors>
                    <id>proc-handle-range-violations</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>700.0</x>
                        <y>400.0</y>
                    </position>
                    <type>org.apache.nifi.processors.standard.PutFile</type>
                    <name>Save Range Violations</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>Directory</key>
                                <value>/data/quality-violations/range-checks</value>
                            </entry>
                            <entry>
                                <key>Conflict Resolution Strategy</key>
                                <value>replace</value>
                            </entry>
                        </properties>
                        <autoTerminatedRelationships>
                            <element>success</element>
                            <element>failure</element>
                        </autoTerminatedRelationships>
                    </config>
                </processors>

                <!-- Processor 10: Handle Anomalies -->
                <processors>
                    <id>proc-handle-anomalies</id>
                    <parentGroupId>root-pg</parentGroupId>
                    <position>
                        <x>1300.0</x>
                        <y>400.0</y>
                    </position>
                    <type>org.apache.nifi.processors.standard.PutFile</type>
                    <name>Save Anomalies</name>
                    <state>STOPPED</state>
                    <config>
                        <properties>
                            <entry>
                                <key>Directory</key>
                                <value>/data/quality-violations/anomalies</value>
                            </entry>
                            <entry>
                                <key>Conflict Resolution Strategy</key>
                                <value>replace</value>
                            </entry>
                        </properties>
                        <autoTerminatedRelationships>
                            <element>success</element>
                            <element>failure</element>
                        </autoTerminatedRelationships>
                    </config>
                </processors>

                <!-- Connections -->
                <connections>
                    <id>conn-1</id>
                    <source>
                        <id>proc-query-iceberg</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </source>
                    <destination>
                        <id>proc-check-nulls</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </destination>
                    <selectedRelationships>
                        <element>success</element>
                    </selectedRelationships>
                </connections>

                <connections>
                    <id>conn-2</id>
                    <source>
                        <id>proc-check-nulls</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </source>
                    <destination>
                        <id>proc-check-ranges</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </destination>
                    <selectedRelationships>
                        <element>valid</element>
                    </selectedRelationships>
                </connections>

                <connections>
                    <id>conn-3</id>
                    <source>
                        <id>proc-check-nulls</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </source>
                    <destination>
                        <id>proc-handle-null-violations</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </destination>
                    <selectedRelationships>
                        <element>null_violations</element>
                    </selectedRelationships>
                </connections>

                <connections>
                    <id>conn-4</id>
                    <source>
                        <id>proc-check-ranges</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </source>
                    <destination>
                        <id>proc-check-integrity</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </destination>
                    <selectedRelationships>
                        <element>valid</element>
                    </selectedRelationships>
                </connections>

                <connections>
                    <id>conn-5</id>
                    <source>
                        <id>proc-check-ranges</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </source>
                    <destination>
                        <id>proc-handle-range-violations</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </destination>
                    <selectedRelationships>
                        <element>range_violations</element>
                    </selectedRelationships>
                </connections>

                <connections>
                    <id>conn-6</id>
                    <source>
                        <id>proc-check-integrity</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </source>
                    <destination>
                        <id>proc-detect-anomalies</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </destination>
                    <selectedRelationships>
                        <element>success</element>
                    </selectedRelationships>
                </connections>

                <connections>
                    <id>conn-7</id>
                    <source>
                        <id>proc-detect-anomalies</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </source>
                    <destination>
                        <id>proc-generate-report</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </destination>
                    <selectedRelationships>
                        <element>normal</element>
                    </selectedRelationships>
                </connections>

                <connections>
                    <id>conn-8</id>
                    <source>
                        <id>proc-detect-anomalies</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </source>
                    <destination>
                        <id>proc-handle-anomalies</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </destination>
                    <selectedRelationships>
                        <element>anomalies</element>
                    </selectedRelationships>
                </connections>

                <connections>
                    <id>conn-9</id>
                    <source>
                        <id>proc-generate-report</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </source>
                    <destination>
                        <id>proc-publish-metrics</id>
                        <groupId>root-pg</groupId>
                        <type>PROCESSOR</type>
                    </destination>
                    <selectedRelationships>
                        <element>success</element>
                    </selectedRelationships>
                </connections>
            </contents>
            <name>Data Quality Pipeline</name>
        </processGroups>
    </snippet>
    <timestamp>2026-02-05T11:00:00Z</timestamp>
</template>
